<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Status indicator (Acts as the primary header now) -->
    <TextView
        android:id="@+id/tvRawDataStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2a2a3e"
        android:padding="16dp"
        android:text="Monitoring for nearby trackers"
        android:textColor="#00E676"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabTextColor="#b0b0b0"
        app:tabSelectedTextColor="#ffffff"
        app:tabIndicatorColor="#4CAF50"
        android:background="#2a2a3e"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hidden controls for internal logic -->
    <Button android:id="@+id/btnStartStop" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout
        android:id="@+id/devControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <EditText android:id="@+id/etDumpFilename" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btnDumpToggle" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btnDecodeToggle" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

</LinearLayout>
